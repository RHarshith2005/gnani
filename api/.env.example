[TEMPLATE]
# ---- Gnani (server only; never put these in web/.env) -----------------------
GNANI_API_KEY=
GNANI_KEY_ID=
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_SPEED=1.0
GNANI_SAMPLE_RATE=16000
# Optional per-language agent voice overrides (Timbre v3.0 voices speak all
# three languages; vendors are resolved from config/voices.json).
GNANI_VOICE_KN=Shivani
GNANI_VOICE_HI=Shivani
GNANI_VOICE_EN=Shivani

# ---- Prisma VAD / domain training (sent as handshake headers) --------------
# Laptop mic defaults: complete sentences over fastest possible transcript.
GNANI_VAD_THRESHOLD=0.6
GNANI_MIN_SILENCE_MS=700
GNANI_MIN_SPEECH_MS=150
GNANI_STT_TOPIC=apartment society bulk purchase of water cans, milk and vegetables
# Comma-separated keyterms to favour (JSON-escaped automatically).
# GNANI_STT_KEYTERMS=NegoAI,water can,society,delivery,milk,vegetables

# ---- Optional LLM (OpenAI-compatible, JSON mode) ---------------------------
# Leave empty for the deterministic scripted composer.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ---- Storage ---------------------------------------------------------------
# Local demo store (SQLite, zero config)
NEGOAI_DB=api/negoai.sqlite3
# Supabase (migrations in supabase/migrations; secret key is server-only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
# Postgres URI, only needed to apply supabase/migrations (scripts/apply_supabase.py).
SUPABASE_DB_URL=

# ---- Demo ------------------------------------------------------------------
# 1.0 = natural pace, 0.5 = snappier. The guided demo scales every pause.
DEMO_PACE=0.55

# ---- Voice credit guard ----------------------------------------------------
# Characters of Timbre TTS allowed per session and for the whole process.
# When either cap is hit the agent continues in text with English subtitles.
SESSION_TTS_CHARS=12000
CREDIT_BUDGET=60000

# ---- Transport -------------------------------------------------------------
ALLOWED_ORIGINS=*
CORS_ORIGINS=*
